<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Verify your account</title>
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }

      .container {
        max-width: 480px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
      }

      .header {
        background-color: #16a34a;
        color: white;
        text-align: center;
        padding: 24px 16px;
      }

      .header h1 {
        margin: 0;
        font-size: 22px;
      }

      .content {
        padding: 32px 24px;
        text-align: center;
      }

      .content p {
        color: #444;
        line-height: 1.5;
        font-size: 15px;
      }

      .button {
        display: inline-block;
        background-color: #16a34a;
        color: #ffffff !important;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 6px;
        margin-top: 20px;
        font-weight: 600;
        transition: background-color 0.2s ease;
      }

      .button:hover {
        background-color: #15803d;
      }

      .footer {
        background-color: #f1f5f9;
        text-align: center;
        padding: 16px;
        font-size: 13px;
        color: #6b7280;
      }

      .footer a {
        color: #16a34a;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>Welcome!</h1>
      </div>

      <div class="content">
        <p>Thank you for signing up for <strong>YourApp</strong> 🎉</p>
        <p>
          To activate your account, please click the button below.
        </p>

        <a href="{{verifyLink}}" class="button">Verify Account</a>

        <p style="margin-top: 30px; font-size: 13px; color: #6b7280;">
          If you didn’t create an account, you can safely ignore this email.
        </p>
      </div>

      <div class="footer">
        <p>
          &copy; {{year}} YourApp. All rights reserved. <br />
          <a href="https://yourapp.com">yourapp.com</a>
        </p>
      </div>
    </div>
  </body>
</html>
